REGION=ap-southeast-1
SERVICE=ark
VERSION=2024-01-01
BASE_URL=https://ark.ap-southeast-1.byteplusapi.com/
TERMINAL=request
POLL_INTERVAL_MS=3000
POLL_MAX_ATTEMPTS=40

# ---- Ark API (required for generation) --------------------------------------------
# The ONLY place the Ark key lives — every route reads it from here; the browser never
# holds a key. WARNING: this key pays for every visitor — put the deployment behind your
# own access control (VPN / SSO proxy).
MODELARK_API_KEY=

# Ark base URL for your region — REQUIRED (no default), e.g.:
#   https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_API_BASE_URL=

# ---- AI MediaKit (Tools → Video Enhance) — both REQUIRED for that tab, no defaults ---
# A separate MediaKit API key (AI MediaKit console → API keys) and region endpoint, e.g.:
#   https://mediakit.ap-southeast-1.bytepluses.com
MODELARK_MEDIAKIT_API_KEY=
MODELARK_MEDIAKIT_BASE_URL=

# ---- Models -----------------------------------------------------------------------
# Each slot holds a public model name (filled in below — they work as they are) or the
# id of an endpoint you created for that model (ep-…). An empty slot ERRORS with its
# variable name; nothing falls back to another model.
#
# For the proper experience, create an ENDPOINT for every model you use: Ark console →
# Model Hub → the model → Create endpoint, then paste its ep-… id here. Endpoints give
# your account its own rate limits, quota and usage tracking per model; the public
# names share the account-wide defaults. Ids that look like ep-… are account-scoped.
MODELARK_MODEL_REASONER=seed-2-0-pro-260328                  # Seed 2.0 Pro planner, selectable in Project settings
MODELARK_MODEL_REASONER_21_TURBO=dola-seed-2-1-turbo-260628  # Seed 2.1 Turbo — the DEFAULT planner
MODELARK_MODEL_REASONER_SC=                                  # optional: Seed-SC planner — endpoint only (ep-…), no public name
# Every reasoner slot above uses the /responses API — that is assumed for whatever id you
# set them to, ep-… included. Only set this if you point a reasoner slot at a genuinely
# chat-shaped model.
MODELARK_REASONER_PROTOCOL=                                  # optional: responses|chat — overrides the shape for ALL reasoner slots
MODELARK_MODEL_AGENT=dola-seed-evolving                      # the film agent's model (scripts/film-agent.mjs)
MODELARK_MODEL_SEEDREAM=seedream-5-0-260128                  # Seedream 5.0 Lite
MODELARK_MODEL_SEEDREAM_PRO=dola-seedream-5-0-pro-260628     # Seedream 5.0 Pro
MODELARK_MODEL_SEEDREAM_55=dola-seedream-5-5-261028          # Seedream 5.5
MODELARK_MODEL_SEEDANCE=dreamina-seedance-2-0-260128         # Seedance 2.0
MODELARK_MODEL_SEEDANCE_FAST=dreamina-seedance-2-0-fast-260128   # Seedance 2.0 Fast
MODELARK_MODEL_SEEDANCE_MINI=dreamina-seedance-2-0-mini-260615   # Seedance 2.0 Mini
MODELARK_MODEL_SEEDANCE_25=dreamina-seedance-2-5-260628      # Seedance 2.5 — needs an active 2.5 resource pack
MODELARK_MODEL_SEEDANCE_25_PREMIUM=dreamina-seedance-2-5-premium-260915  # Seedance 2.5 Premium

# ---- Seed Audio — REQUIRED if the Audio agent is used ------------------------------
BYTEPLUSVOICE_API_KEY=
BYTEPLUSVOICE_BASE_URL=             # e.g. https://voice.ap-southeast-1.bytepluses.com
MODELARK_MODEL_SEED_AUDIO=seed-audio-1.0

# ---- TOS object storage (required for durable media + cloud project saves) --------
# An IAM key pair with access to the bucket, plus the bucket in your region.
MODELARK_ASSET_ACCESS_KEY=
MODELARK_ASSET_SECRET_KEY=
MODELARK_TOS_BUCKET=
MODELARK_TOS_REGION=ap-southeast-1
MODELARK_TOS_ENDPOINT=              # optional; defaults to tos-<region>.bytepluses.com
MODELARK_TOS_OBJECT_PREFIX=         # optional key prefix for staged uploads
MODELARK_TOS_PUBLIC_BASE_URL=       # ONLY if the bucket is public-read; else leave empty (presigned URLs are used)

# ---- Assets API (optional) --------------------------------------------------------
MODELARK_ASSET_GROUP_ID=            # optional: pin the asset-library group; else one stable group is created and reused

