# ---- Required -------------------------------------------------------------
# Region base URL for the ModelArk API, e.g. https://ark.ap-southeast.bytepluses.com/api/v3
MODELARK_API_BASE_URL=
# Server-side API key. With this set, nobody has to paste a key into the browser.
MODELARK_API_KEY=

# ---- Model ids — set at least one; the picker lists whichever are present ---
MODELARK_MODEL_SEEDANCE_25=
MODELARK_MODEL_SEEDANCE=
MODELARK_MODEL_SEEDANCE_FAST=
MODELARK_MODEL_SEEDANCE_MINI=

# ---- Asset upload (needed for the Asset Library) ---------------------------
# TOS object storage: uploaded files are stored here and referenced by url.
MODELARK_TOS_BUCKET=
MODELARK_TOS_REGION=
MODELARK_TOS_ENDPOINT=
MODELARK_TOS_PUBLIC_BASE_URL=
MODELARK_TOS_OBJECT_PREFIX=seedance-playground/uploads
# Assets API: registers an upload so it can ride as a trusted asset id rather than a
# raw url. Without these, uploads still work — they just ride as urls.
MODELARK_ASSET_ACCESS_KEY=
MODELARK_ASSET_SECRET_KEY=
MODELARK_ASSET_GROUP_ID=
