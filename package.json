{
  "name": "modelark-starter-kit",
  "version": "1.0.0",
  "private": true,
  "author": "BytePlus Team",
  "description": "Starter kit for Seedream, Seedance, and Seed APIs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/fetch-models.js && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "update-models": "node scripts/fetch-models.js",
    "dev:next": "next dev -p 3000",
    "dev:electron": "wait-on http://localhost:3000 && electron .",
    "dev:desktop": "concurrently -k \"npm:dev:next\" \"npm:dev:electron\"",
    "start:desktop": "NODE_ENV=production electron .",
    "build:desktop": "npm run build && electron-builder -m -w"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.10",
    "@volcengine/tos-sdk": "^2.9.1",
    "@xyflow/react": "^12.10.1",
    "ffmpeg-static": "^5.2.0",
    "next": "16.2.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "concurrently": "^10.0.3",
    "dotenv": "^17.3.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "node-mocks-http": "^1.17.2",
    "wait-on": "^9.0.10",
    "whatwg-fetch": "^3.6.20"
  },
  "build": {
    "appId": "com.modelark.starterkit",
    "productName": "ModelArk Starter Kit",
    "asar": true,
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}/**/*",
      "!**/node_modules/.bin",
      "!**/*.{o,hprof,orig,pyc,pyo,rbc,swp,tod,ts,tsx,web}",
      "!.next/cache/**/*"
    ],
    "directories": {
      "output": "dist/${os}"
    },
    "mac": {
      "target": "dmg",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "win": {
      "target": "nsis"
    }
  }
}
